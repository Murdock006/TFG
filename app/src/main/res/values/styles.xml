<resources>

    <style name="Tema.TFG.Moderno" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Core colors -->
        <item name="colorPrimary">@color/primario</item>
        <item name="colorOnPrimary">@color/on_acento</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto_principal</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="materialCardViewStyle">@style/Widget.TFG.Tarjeta</item>
        <!-- Forzar colores de texto por defecto -->
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="android:editTextStyle">@style/Widget.TFG.EditText</item>
        <item name="textAppearanceBody1">@style/TextAppearance.TFG.Cuerpo</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.TFG.Titulo</item>
        <!-- BottomNavigationView compacta -->
        <item name="bottomNavigationStyle">@style/Widget.TFG.BottomNav</item>
    </style>

    <!-- BottomNavigationView compacta: sin padding extra del sistema -->
    <style name="Widget.TFG.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="itemPaddingTop">4dp</item>
        <item name="itemPaddingBottom">4dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.TFG.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.TFG.NavLabel</item>
    </style>

    <style name="TextAppearance.TFG.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
    </style>

    <!-- EditText con fondo visible gris claro + borde negro -->
    <style name="Widget.TFG.EditText" parent="@style/Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textColorHint">@color/gris</item>
        <item name="android:background">@drawable/bg_input_campo</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- TextInputLayout outlined con colores correctos -->
    <style name="Widget.TFG.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/superficie_variant</item>
        <item name="boxStrokeColor">@color/negro</item>
        <item name="hintTextColor">@color/gris</item>
        <item name="android:textColorHint">@color/gris</item>
    </style>

    <!-- Botón relleno negro -->
    <style name="Widget.TFG.Boton.Relleno" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/btn_filled_black</item>
        <item name="android:textColor">@color/on_acento</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Botón contorno negro sobre fondo blanco -->
    <style name="Widget.TFG.Boton.Contorno" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/negro</item>
        <item name="strokeWidth">2dp</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Tarjeta Material con elevación y sombra -->
    <style name="Widget.TFG.Tarjeta" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/divisor</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Tarjeta destacada (con borde negro marcado) -->
    <style name="Widget.TFG.Tarjeta.Destacada" parent="Widget.TFG.Tarjeta">
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">@color/negro</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="TextAppearance.TFG.Titulo" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.TFG.SubTitulo" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.TFG.Cuerpo" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.TFG.Meta" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/gris</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Estilo para botón Google -->
    <style name="Widget.TFG.Boton.Google" parent="Widget.MaterialComponents.Button">
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/ripple_google</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.TFG.Boton.Relleno.Seleccionar" parent="Widget.TFG.Boton.Relleno" />

    <!-- (reservado para futuros estilos de navegación) -->

</resources>