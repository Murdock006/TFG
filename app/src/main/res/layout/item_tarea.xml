<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_xs"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="@dimen/corner_radius_lg"
    app:cardElevation="@dimen/elevation_pressed"
    app:cardBackgroundColor="@color/superficie"
    app:strokeColor="@color/divisor"
    app:strokeWidth="@dimen/stroke_thin"
    app:rippleColor="@color/sombra_sutil">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:foreground="?attr/selectableItemBackground">

        <!-- Barra indicador de dificultad (izquierda) -->
        <View
            android:id="@+id/vIndicator"
            android:layout_width="@dimen/stroke_thick"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:minHeight="48dp"
            android:background="@color/primario"
            android:contentDescription="@string/cd_indicador_dificultad" />

        <!-- Contenido texto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloTarea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_tarea_ejemplo"
                android:textColor="@color/texto_principal"
                android:textStyle="bold"
                android:textSize="15sp"
                android:contentDescription="@string/titulo_tarea_ejemplo"
                android:textAppearance="@style/TextAppearance.TFG.Titulo" />

            <TextView
                android:id="@+id/tvDificultad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dificultad_facil"
                android:textColor="@color/gris"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.TFG.Label" />

            <TextView
                android:id="@+id/tvMetaTarea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meta_tarea_ejemplo"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                android:layout_marginTop="3dp"
                android:textAppearance="@style/TextAppearance.TFG.Label" />

            <TextView
                android:id="@+id/tvAsignado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/asignado_por_defecto"
                android:textColor="@color/gris"
                android:textSize="11sp"
                android:layout_marginTop="3dp"
                android:visibility="gone"
                android:textAppearance="@style/TextAppearance.TFG.Label" />
        </LinearLayout>

        <!-- Botón acción -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccionTarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            style="@style/Widget.TFG.Boton.Contorno"
            android:text=""
            android:textAllCaps="false"
            android:minHeight="36dp"
            android:contentDescription="@string/cd_boton_asignar" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
