<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    app:cardCornerRadius="@dimen/corner_radius_lg"
    app:cardElevation="@dimen/elevation_pressed"
    app:cardBackgroundColor="@color/superficie"
    app:strokeColor="@color/divisor"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg"
        android:gravity="center_horizontal">

        <!-- Avatar placeholder -->
        <ImageView
            android:id="@+id/ivMiembroAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/perfil"
            android:contentDescription="@string/cd_avatar_miembro"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_avatar_miembro"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tvMiembroNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="Nombre"
            android:textColor="@color/texto_principal"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.TFG.SubTitulo" />

        <TextView
            android:id="@+id/tvMiembroPuntos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0"
            android:textColor="@color/negro"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMiembroRol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="creador"
            android:textColor="@color/gris"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textAppearance="@style/TextAppearance.TFG.Label" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
