<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="72dp">

        <!-- Tarjeta detalle principal -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/corner_radius_lg"
            app:cardElevation="@dimen/elevation_pressed"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/divisor"
            app:strokeWidth="@dimen/stroke_thin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl" android:paddingBottom="76dp">

                <TextView
                    android:id="@+id/tvDetalleTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal"
                    android:text="@string/titulo_placeholder" />

                <TextView
                    android:id="@+id/tvDetalleMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp"
                    android:text="@string/meta_placeholder" />

                <TextView
                    android:id="@+id/tvDetalleAsignado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/gris"
                    android:textSize="13sp"
                    android:text="" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divisor"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_md" />

                <TextView
                    android:id="@+id/tvDetalleDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_principal"
                    android:textSize="14sp"
                    android:text="@string/descripcion_placeholder" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta acciones -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_radius_sm"
            app:cardElevation="@dimen/elevation_default"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/divisor"
            app:strokeWidth="@dimen/stroke_thin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md"
                android:gravity="end" android:paddingBottom="76dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetalleAsignar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.TFG.Boton.Contorno"
                    android:text="@string/asignar"
                    android:textAllCaps="false"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetalleAccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.TFG.Boton.Relleno"
                    android:text="@string/accion"
                    android:textAllCaps="false"
                    android:layout_marginEnd="@dimen/spacing_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetalleMas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.TFG.Boton.Contorno"
                    android:text="@string/mas"
                    android:textAllCaps="false" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cancelar recurrencia (solo para el creador de una tarea recurrente) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCancelarRecurrencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            app:cardCornerRadius="@dimen/corner_radius_sm"
            app:cardElevation="@dimen/elevation_default"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/divisor"
            app:strokeWidth="@dimen/stroke_thin"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetalleCancelarRecurrencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.TFG.Boton.Contorno"
                android:layout_margin="@dimen/spacing_md"
                android:text="@string/cancelar_recurrencia"
                android:textAllCaps="false" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>

