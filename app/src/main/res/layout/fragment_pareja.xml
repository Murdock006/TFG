<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="20dp"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTituloPareja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perfil de pareja"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvTusPuntos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="18sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvPuntosReservados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reservados: 0"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvPuntosCompanero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="18sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvNombreGrupoSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCrearGrupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear grupo"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnGenerarInvitacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generar invitación"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Código: -"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etCodigoAceptar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Introduce código"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAceptarInvitacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aceptar invitación"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSalirGrupoTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salir"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvGroupName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del grupo"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvGroupMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Miembros: 0"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAbrirGrupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abrir"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnEditarNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvMiembrosTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Miembros del grupo"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMiembros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/bottomContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
