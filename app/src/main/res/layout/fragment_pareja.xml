<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="76dp">

        <TextView
            android:id="@+id/tvTituloPareja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/perfil_pareja_title"
            android:textAppearance="@style/TextAppearance.TFG.Headline"
            android:textColor="@color/texto_principal"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <!-- Tarjeta gráfico circular de tareas -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TFG.Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progreso_tareas"
                    android:textAppearance="@style/TextAppearance.TFG.SubTitulo"
                    android:textColor="@color/texto_principal"
                    android:layout_marginBottom="@dimen/spacing_md" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartTareas"
                    android:layout_width="match_parent"
                    android:layout_height="280dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@color/verde"
                            android:layout_marginEnd="4dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/completadas"
                                android:textAppearance="@style/TextAppearance.TFG.Label"
                                android:textColor="@color/texto_secundario" />

                            <TextView
                                android:id="@+id/tvTareasCompletadas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.TFG.SubTitulo"
                                android:textColor="@color/verde" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@color/azul"
                            android:layout_marginEnd="4dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mis_pendientes"
                                android:textAppearance="@style/TextAppearance.TFG.Label"
                                android:textColor="@color/texto_secundario" />

                            <TextView
                                android:id="@+id/tvTareasPendientesMias"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.TFG.SubTitulo"
                                android:textColor="@color/azul" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@color/naranja"
                            android:layout_marginEnd="4dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/de_otros"
                                android:textAppearance="@style/TextAppearance.TFG.Label"
                                android:textColor="@color/texto_secundario" />

                            <TextView
                                android:id="@+id/tvTareasPendientesOtros"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.TFG.SubTitulo"
                                android:textColor="@color/naranja" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta puntos -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TFG.Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F8F8F8">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tus puntos"
                    android:textAppearance="@style/TextAppearance.TFG.Label"
                    android:textColor="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvTusPuntos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textAppearance="@style/TextAppearance.TFG.Titulo"
                    android:textColor="@color/negro"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/tvPuntosReservados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reservados: 0"
                    android:textAppearance="@style/TextAppearance.TFG.Label"
                    android:textColor="@color/texto_secundario"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divisor"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Puntos compañero/a"
                    android:textAppearance="@style/TextAppearance.TFG.Label"
                    android:textColor="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvPuntosCompanero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textAppearance="@style/TextAppearance.TFG.Titulo"
                    android:textColor="@color/negro"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/tvNombreGrupoSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textAppearance="@style/TextAppearance.TFG.Cuerpo"
                    android:textColor="@color/texto_secundario" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta crear / unirse al grupo -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TFG.Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gestion_grupo"
                    android:textAppearance="@style/TextAppearance.TFG.SubTitulo"
                    android:textColor="@color/texto_principal"
                    android:layout_marginBottom="@dimen/spacing_md" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCrearGrupo"
                    style="@style/Widget.TFG.Boton.Relleno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/crear_grupo"
                    android:textAllCaps="false"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerarInvitacion"
                    style="@style/Widget.TFG.Boton.Contorno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/generar_invitacion"
                    android:textAllCaps="false"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:cardCornerRadius="@dimen/corner_radius_md"
                    app:cardElevation="@dimen/elevation_none"
                    app:cardBackgroundColor="#F5F5F5"
                    app:strokeColor="@color/divisor"
                    app:strokeWidth="@dimen/stroke_thin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/tvCodigo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Código: -"
                            android:textAppearance="@style/TextAppearance.TFG.Cuerpo"
                            android:textColor="@color/texto_principal"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopiarCodigo"
                                style="@style/Widget.TFG.Boton.Contorno"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:icon="@android:drawable/ic_menu_save"
                                android:text="@string/copiar"
                                android:textAllCaps="false"
                                android:layout_marginEnd="@dimen/spacing_xs" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCompartirCodigo"
                                style="@style/Widget.TFG.Boton.Contorno"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:icon="@android:drawable/ic_menu_share"
                                android:text="@string/compartir"
                                android:textAllCaps="false"
                                android:layout_marginStart="@dimen/spacing_xs" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.TFG.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Introduce código de invitación"
                    android:layout_marginBottom="@dimen/spacing_sm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCodigoAceptar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="text"
                        android:textColor="@color/texto_principal"
                        android:textColorHint="@color/gris" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAceptarInvitacion"
                    style="@style/Widget.TFG.Boton.Relleno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/aceptar_invitacion"
                    android:textAllCaps="false"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalirGrupoTop"
                    style="@style/Widget.TFG.Boton.Contorno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/salir_grupo"
                    android:textColor="@color/error"
                    android:textAllCaps="false"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta info del grupo (visible cuando hay grupo) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfoGrupo"
            style="@style/Widget.TFG.Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_xs">

                    <TextView
                        android:id="@+id/tvGroupEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❤️"
                        android:textAppearance="@style/TextAppearance.TFG.Titulo"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/tvGroupName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nombre_grupo"
                        android:textAppearance="@style/TextAppearance.TFG.Titulo"
                        android:textColor="@color/texto_principal" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGroupMembers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Miembros: 0"
                    android:textAppearance="@style/TextAppearance.TFG.Cuerpo"
                    android:textColor="@color/texto_secundario"
                    android:layout_marginBottom="@dimen/spacing_md" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAbrirGrupo"
                        style="@style/Widget.TFG.Boton.Contorno"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Abrir"
                        android:textAllCaps="false"
                        android:layout_marginEnd="@dimen/spacing_xs" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditarNombre"
                        style="@style/Widget.TFG.Boton.Relleno"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Guardar"
                        android:textAllCaps="false" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Miembros del grupo -->
        <TextView
            android:id="@+id/tvMiembrosTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/miembros_grupo"
            android:textAppearance="@style/TextAppearance.TFG.SubTitulo"
            android:textColor="@color/texto_principal"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMiembros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:nestedScrollingEnabled="false" />

        <LinearLayout
            android:id="@+id/emptyStateMiembros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="@dimen/spacing_3xl"
            android:layout_marginTop="@dimen/spacing_lg">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_empty_members"
                android:contentDescription="@string/empty_members_title"
                android:alpha="0.5"
                android:layout_marginBottom="@dimen/spacing_md" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_members_title"
                android:textAppearance="@style/TextAppearance.TFG.SubTitulo"
                android:textColor="@color/texto_principal"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/empty_members_subtitle"
                android:textAppearance="@style/TextAppearance.TFG.Cuerpo"
                android:textColor="@color/texto_secundario"
                android:gravity="center" />
        </LinearLayout>

        <!-- Contenedores ocultos (retrocompatibilidad) -->
        <FrameLayout
            android:id="@+id/bottomContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
