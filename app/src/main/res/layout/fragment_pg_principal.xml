<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="50dp"
    android:paddingBottom="80dp"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <ImageView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/titulo" />

        <!-- Tarjetas de puntos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:weightSum="2">

            <!-- Tarjeta Usuario -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="8dp"
                style="@style/Widget.TFG.Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@color/tarjetaPrincipal">

                    <TextView
                        android:text="@string/tus_puntos"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/puntosUsuario"
                        android:text="@string/cargando"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textSize="20sp"
                        android:textColor="@color/texto_principal" />

                    <TextView
                        android:id="@+id/puntosReservados"
                        android:text="@string/reservados_format"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:text="@string/comprar_puntos"
                        android:textSize="12sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textColor="@color/texto_secundario" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tarjeta Compañero -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="8dp"
                style="@style/Widget.TFG.Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@color/tarjetaPrincipal">

                    <TextView
                        android:text="@string/tu_companero"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/nombreGrupo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/guion"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/puntosCompanero"
                        android:text="@string/cero"
                        android:textSize="20sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textColor="@color/texto_principal" />

                    <TextView
                        android:id="@+id/miembrosCount"
                        android:text="@string/miembros_format"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:text="@string/vincula_pareja"
                        android:textSize="12sp"
                        android:textColor="@color/texto_secundario"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Título Asignar Tareas -->
        <TextView
            android:id="@+id/tituloAsignar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/asignar_tareas"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/texto_principal"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:id="@+id/textViewResultados"
            android:textColor="@color/texto_principal" />

        <!-- Categorías (lista vertical: una tarjeta por fila) -->
        <LinearLayout
            android:id="@+id/bloqueCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ejemplo de categoría (cocina) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/Widget.TFG.Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/categoriaCocina"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Widget.TFG.Boton.Relleno"
                        android:text="@string/categoria_cocina"
                        android:textColor="@color/on_acento" />

                    <Button
                        android:id="@+id/btnAsignarCocina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.TFG.Boton.Contorno"
                        android:text="@string/asignar"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Ropa -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/Widget.TFG.Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/categoriaRopa"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Widget.TFG.Boton.Relleno"
                        android:text="@string/categoria_ropa"
                        android:textColor="@color/on_acento" />

                    <Button
                        android:id="@+id/btnAsignarRopa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.TFG.Boton.Contorno"
                        android:text="@string/asignar"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Limpieza -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/Widget.TFG.Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/categoriaLimpieza"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Widget.TFG.Boton.Relleno"
                        android:text="@string/categoria_limpieza"
                        android:textColor="@color/on_acento" />

                    <Button
                        android:id="@+id/btnAsignarLimpieza"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.TFG.Boton.Contorno"
                        android:text="@string/asignar"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Mascotas -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/Widget.TFG.Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/categoriaMascotas"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Widget.TFG.Boton.Relleno"
                        android:text="@string/categoria_mascotas"
                        android:textColor="@color/on_acento" />

                    <Button
                        android:id="@+id/btnAsignarMascotas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.TFG.Boton.Contorno"
                        android:text="@string/asignar"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Recados -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/Widget.TFG.Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/categoriaRecados"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Widget.TFG.Boton.Relleno"
                        android:text="@string/categoria_recados"
                        android:textColor="@color/on_acento" />

                    <Button
                        android:id="@+id/btnAsignarRecados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.TFG.Boton.Contorno"
                        android:text="@string/asignar"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Personalizado -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.TFG.Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/categoriaPersonalizado"
                        android:textSize="11sp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Widget.TFG.Boton.Relleno"
                        android:text="@string/categoria_personalizado"
                        android:textColor="@color/on_acento" />

                    <Button
                        android:id="@+id/btnAsignarPersonalizado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.TFG.Boton.Contorno"
                        android:text="@string/asignar"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Vista rápida de tareas recientes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tareas_recientes"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:textSize="16sp"
            android:textColor="@color/texto_principal" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTareasHome"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>

</ScrollView>
