<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="50dp"
    android:paddingBottom="80dp"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@drawable/degradado">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <ImageView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/titulo" />

        <!-- Tarjetas de puntos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:weightSum="2">

            <!-- Tarjeta Usuario -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:text="Tus puntos"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:id="@+id/puntosUsuario"
                        android:text="1000"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textSize="20sp"
                         />

                    <TextView
                        android:text="Puedes comprar más: 1000 = 5€"
                        android:textSize="12sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textColor="@android:color/darker_gray" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tarjeta Compañer@ -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:text="Tu compañer@"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textColor="@android:color/black" />

                    <TextView
                        android:id="@+id/puntosCompanero"
                        android:text="0"
                        android:textSize="20sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textColor="@android:color/holo_red_dark" />

                    <TextView
                        android:text="Vincula a tu pareja para ver sus puntos"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"

                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Título Asignar Tareas -->
        <TextView
            android:id="@+id/tituloAsignar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asignar Tareas"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="32dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="aaaa"
            android:id="@+id/textViewResultados" />


        <!-- Categorías -->
        <LinearLayout
            android:id="@+id/bloqueCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:weightSum="2">

            <!-- Columna izquierda -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp">

                <Button
                    android:id="@+id/categoriaCocina"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🍳 COCINA"

                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/categoriaLimpieza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧼 LIMPIEZA"

                    android:textColor="@android:color/white"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/categoriaRopa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧺 ROPA"

                    android:textColor="@android:color/white"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Columna derecha -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp">

                <Button
                    android:id="@+id/categoriaMascotas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🐾 MASCOTAS"

                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/categoriaRecados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧾 RECADOS"

                    android:textColor="@android:color/white"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/categoriaPersonalizado"
                    android:textSize="11dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚙️PERSONALIZADO"

                    android:textColor="@android:color/white"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tarjetas inferiores independientes -->
        <LinearLayout
            android:id="@+id/bloqueInferior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:weightSum="3">

            <!-- Calendario -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <Button
                    android:id="@+id/verCalendario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📅 Calendario"
                    android:textColor="@android:color/white"

                    android:textSize="12dp" />
            </androidx.cardview.widget.CardView>

            <!-- Recompensas -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <Button
                    android:id="@+id/misRecompensas"
                    android:textSize="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎁 Recompensas"

                    android:textColor="@android:color/white" />



            </androidx.cardview.widget.CardView>

            <!-- Perfil de Pareja -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <Button
                    android:id="@+id/perfilPareja"
                    android:textSize="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥 Perfil de Pareja"

                    android:textColor="@android:color/white" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
