<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <!-- Cabecera: título arriba, puntos debajo -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/llCabeceraRecompensas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_xl"
        android:layout_marginBottom="@dimen/spacing_sm"
        app:cardCornerRadius="@dimen/corner_radius_xl"
        app:cardElevation="@dimen/elevation_pressed"
        app:cardBackgroundColor="@color/superficie"
        app:strokeColor="@color/divisor"
        app:strokeWidth="@dimen/stroke_thin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg"
            android:background="@color/superficie">

            <TextView
                android:id="@+id/tvTituloRecompensas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recompensas_title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal"
                android:textAppearance="@style/TextAppearance.TFG.Headline" />

            <TextView
                android:id="@+id/tvMisPuntos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="— pts"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/negro"
                android:background="@drawable/bg_badge_puntos"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textAppearance="@style/TextAppearance.TFG.Label" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tabs: Disponibles / Pendientes / Historial -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/llTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="@dimen/corner_radius_lg"
        app:cardElevation="@dimen/elevation_pressed"
        app:cardBackgroundColor="@color/superficie"
        app:strokeColor="@color/divisor"
        app:strokeWidth="@dimen/stroke_thin"
        app:layout_constraintTop_toBottomOf="@id/llCabeceraRecompensas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/btnTabDisponibles"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Disponibles"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/tab_activo"
                android:layout_marginEnd="3dp"
                android:textAppearance="@style/TextAppearance.TFG.Label" />

            <TextView
                android:id="@+id/btnTabPendientes"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Pendientes"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:background="@drawable/tab_inactivo"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:textAppearance="@style/TextAppearance.TFG.Label" />

            <TextView
                android:id="@+id/btnTabHistorial"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Historial"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:background="@drawable/tab_inactivo"
                android:layout_marginStart="3dp"
                android:textAppearance="@style/TextAppearance.TFG.Label" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Nota informativa del 10% (solo visible en pestaña Disponibles) -->
    <TextView
        android:id="@+id/tvInfoRecompensas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginTop="6dp"
        android:padding="12dp"
        android:textSize="12sp"
        android:textColor="@color/texto_secundario"
        android:background="@drawable/bg_badge_puntos"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textAppearance="@style/TextAppearance.TFG.Label" />

    <!-- Lista principal -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvInfoRecompensas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecompensas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="68dp"
                android:clipToPadding="false" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="32dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/ic_empty_rewards"
                    android:contentDescription="@string/empty_rewards_title"
                    android:alpha="0.5"
                    android:layout_marginBottom="@dimen/spacing_lg" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_rewards_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.TFG.Titulo" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/empty_rewards_subtitle"
                    android:textSize="14sp"
                    android:textColor="@color/texto_secundario"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.TFG.Cuerpo" />
            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- FAB crear recompensa personalizada -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCrearRecompensa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginBottom="52dp"
        android:contentDescription="@string/cd_crear_recompensa"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@android:drawable/ic_input_add" />

</androidx.constraintlayout.widget.ConstraintLayout>
