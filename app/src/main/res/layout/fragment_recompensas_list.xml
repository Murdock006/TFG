<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <!-- Cabecera: título arriba, puntos debajo -->
    <LinearLayout
        android:id="@+id/llCabeceraRecompensas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTituloRecompensas"
            style="@style/TextAppearance.TFG.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recompensas" />

        <TextView
            android:id="@+id/tvMisPuntos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="— pts"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal"
            android:background="@drawable/bg_rounded_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />
    </LinearLayout>

    <!-- Tabs: Disponibles / Pendientes / Historial -->
    <LinearLayout
        android:id="@+id/llTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/llCabeceraRecompensas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnTabDisponibles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Disponibles"
            android:textSize="12sp"
            style="@style/Widget.TFG.Boton.Relleno"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnTabPendientes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pendientes"
            android:textSize="12sp"
            style="@style/Widget.TFG.Boton.Contorno"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnTabHistorial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Historial"
            android:textSize="12sp"
            style="@style/Widget.TFG.Boton.Contorno"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Nota informativa del 10% (solo visible en pestaña Disponibles) -->
    <TextView
        android:id="@+id/tvInfoRecompensas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textSize="12sp"
        android:textColor="@color/texto_secundario"
        android:background="#F5F5F5"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lista principal -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecompensas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvInfoRecompensas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- FAB crear recompensa personalizada -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCrearRecompensa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Crear recompensa personalizada"
        app:srcCompat="@android:drawable/ic_input_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
