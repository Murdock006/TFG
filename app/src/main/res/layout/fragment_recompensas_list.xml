<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <!-- Cabecera: título arriba, puntos debajo -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/llCabeceraRecompensas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="@color/divisor"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#F8F8F8">

            <TextView
                android:id="@+id/tvTituloRecompensas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recompensas"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal" />

            <TextView
                android:id="@+id/tvMisPuntos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="— pts"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/negro"
                android:background="@drawable/bg_badge_puntos"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tabs: Disponibles / Pendientes / Historial -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/llTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="@color/divisor"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/llCabeceraRecompensas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/btnTabDisponibles"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Disponibles"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/tab_activo"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/btnTabPendientes"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Pendientes"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:background="@drawable/tab_inactivo"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/btnTabHistorial"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Historial"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:background="@drawable/tab_inactivo"
                android:layout_marginStart="3dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Nota informativa del 10% (solo visible en pestaña Disponibles) -->
    <TextView
        android:id="@+id/tvInfoRecompensas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:padding="12dp"
        android:textSize="12sp"
        android:textColor="@color/texto_secundario"
        android:background="@drawable/bg_badge_puntos"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lista principal -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecompensas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="68dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvInfoRecompensas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- FAB crear recompensa personalizada -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCrearRecompensa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="52dp"
        android:contentDescription="Crear recompensa personalizada"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@android:drawable/ic_input_add" />

</androidx.constraintlayout.widget.ConstraintLayout>
