<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginTop="20dp"
    android:background="@color/fondo">

    <TextView
        android:id="@+id/tvTituloPendientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tareas"
        style="@style/TextAppearance.TFG.Titulo"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/layoutBotonesTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPendientes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.TFG.Boton.Contorno"
            android:textSize="10sp"
            android:text="Pendientes"
            android:textColor="@color/text_color_tareas"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAsignadas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.TFG.Boton.Contorno"
            android:text="Asignadas"
            android:textColor="@color/text_color_tareas"
            android:textSize="10sp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistorial"
            android:textSize="10sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.TFG.Boton.Contorno"
            android:text="Historial"
            android:textColor="@color/text_color_tareas"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- Mensaje cuando el usuario no pertenece a ningún grupo -->
    <LinearLayout
        android:id="@+id/layoutSinGrupo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:alpha="0.4"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No perteneces a ningún grupo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Crea o únete a un grupo desde la sección\nPerfil de pareja para ver tus tareas."
            android:textSize="14sp"
            android:textColor="@color/texto_secundario"
            android:gravity="center" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTareasPendientes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp" />

</LinearLayout>
