<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <!-- Cabecera con título -->
    <TextView
        android:id="@+id/tvTituloPendientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tareas"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/texto_principal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp" />

    <!-- Tabs de sección -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="@color/divisor"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/layoutBotonesTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/btnPendientes"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Pendientes"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/tab_activo"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/btnAsignadas"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Asignadas"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:background="@drawable/tab_inactivo"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/btnHistorial"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Historial"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:background="@drawable/tab_inactivo"
                android:layout_marginStart="3dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Sin grupo -->
    <LinearLayout
        android:id="@+id/layoutSinGrupo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:contentDescription=""
            android:alpha="0.4"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No perteneces a ningún grupo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Crea o únete a un grupo desde Perfil de pareja."
            android:textSize="13sp"
            android:textColor="@color/texto_secundario"
            android:gravity="center" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTareasPendientes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="72dp"
        android:clipToPadding="false" />

</LinearLayout>
