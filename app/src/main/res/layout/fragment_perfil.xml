<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="72dp">

        <!-- Título con barrita de acento (coherente con los headers de Inicio) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_lg">

            <View
                android:layout_width="@dimen/stroke_thick"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_accent_bar" />

            <TextView
                android:id="@+id/tv_perfil_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil"
                android:textAppearance="@style/TextAppearance.TFG.Headline"
                android:textColor="@color/texto_principal" />
        </LinearLayout>

        <!-- Sección Avatar: tarjeta con radio 16dp, elevación de contenido y sin borde duro -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            app:cardBackgroundColor="@color/superficie"
            app:cardCornerRadius="@dimen/corner_radius_lg"
            app:cardElevation="@dimen/elevation_card"
            app:cardUseCompatPadding="true"
            app:contentPadding="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_lg">

                <!-- Avatar con anillo esmeralda; el padding interno deja visible el anillo -->
                <ImageView
                    android:id="@+id/ivAvatarPerfil"
                    android:layout_width="136dp"
                    android:layout_height="136dp"
                    android:padding="@dimen/spacing_xs"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/cd_avatar_usuario"
                    android:background="@drawable/bg_avatar_ring"
                    android:src="@drawable/perfil" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeleccionarAvatar"
                    style="@style/Widget.TFG.Boton.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_min_height"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/cambiar_avatar" />

                <ProgressBar
                    android:id="@+id/pbCargandoAvatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvErrorAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textColor="@color/error"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de información: radio 16dp, elevación 3dp, sin borde duro -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/superficie"
            app:cardCornerRadius="@dimen/corner_radius_lg"
            app:cardElevation="@dimen/elevation_card"
            app:cardUseCompatPadding="true"
            app:contentPadding="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:id="@+id/tv_perfil_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/info_perfil"
                    android:textAppearance="@style/TextAppearance.TFG.Cuerpo"
                    android:textColor="@color/texto_principal"
                    android:lineSpacingExtra="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCambiarNombre"
                    style="@style/Widget.TFG.Boton.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_min_height"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/cambiar_nombre" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Acción destructiva: contorno y texto en rojo de error -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminarCuenta"
            style="@style/Widget.TFG.Boton.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/eliminar_cuenta"
            android:textColor="@color/error"
            app:strokeColor="@color/error" />

    </LinearLayout>

</ScrollView>
