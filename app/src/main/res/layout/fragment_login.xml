<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context="com.example.tfg.vista.FragmentLogin">

    <!-- Logo superior -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/logo_desc"
        android:src="@drawable/teamtask"
        android:adjustViewBounds="true"
        android:scaleType="centerInside"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.32" />

    <!-- Zona de inputs en scroll -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/inputs_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/inputsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Campo email -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/usuario_hint"
                app:boxBackgroundColor="#F5F5F5"
                app:boxStrokeColor="@color/negro"
                app:hintTextColor="@color/gris">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/usuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/gris"
                    android:autofillHints="username"
                    android:imeOptions="flagNoExtractUi" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contraseiaLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/contrasena_hint"
                android:layout_marginTop="12dp"
                app:boxBackgroundColor="#F5F5F5"
                app:boxStrokeColor="@color/negro"
                app:hintTextColor="@color/gris"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textocontraseA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="flagNoExtractUi"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/gris"
                    android:autofillHints="password" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Registro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/sinRegistro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aun_no_registrado"
                    android:textColor="@color/texto_principal"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonTransparente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/rojo"
                    app:strokeWidth="1dp"
                    android:text="@string/pincha_aqui"
                    android:textColor="@color/rojo"
                    android:textAllCaps="false"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Botón iniciar sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/iniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.Button"
                app:cornerRadius="10dp"
                android:backgroundTint="@color/negro"
                android:text="@string/iniciar_sesion"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:layout_marginTop="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

            <!-- Divisor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divisor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  o  "
                    android:textColor="@color/gris"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divisor" />
            </LinearLayout>

            <!-- Botón Google -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="@style/Widget.TFG.Boton.Google"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="Iniciar sesión con Google"
                android:text="Continuar con Google"
                android:textColor="@color/google_text"
                app:icon="@drawable/googleg_standard_color_18"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <TextView
                android:id="@+id/tvUsuarioInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                android:visibility="gone"
                android:text="" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
