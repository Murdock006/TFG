<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="72dp">

        <TextView
            android:id="@+id/tvTituloCrear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crear_tarea"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/divisor"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp" android:paddingBottom="76dp">

                <!-- Título de la tarea -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/titulo_hint"
                    app:boxBackgroundColor="#F5F5F5"
                    app:boxStrokeColor="@color/negro"
                    app:hintTextColor="@color/gris">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="text"
                        android:autofillHints="none"
                        android:textColor="@color/texto_principal"
                        android:textColorHint="@color/gris" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Categoría -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categoría"
                    android:textSize="12sp"
                    android:textColor="@color/gris"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_campo"
                    android:padding="4dp" />

                <!-- Dificultad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dificultad"
                    android:textSize="12sp"
                    android:textColor="@color/gris"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spDificultad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_campo"
                    android:padding="4dp" />

                <!-- Puntos -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/puntos_hint"
                    android:layout_marginTop="14dp"
                    app:boxBackgroundColor="#F5F5F5"
                    app:boxStrokeColor="@color/negro"
                    app:hintTextColor="@color/gris">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPuntos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:imeOptions="flagNoExtractUi"
                        android:autofillHints="none"
                        android:textColor="@color/texto_principal"
                        android:textColorHint="@color/gris" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Asignar a -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asignar a"
                    android:textSize="12sp"
                    android:textColor="@color/gris"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spAsignarA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_campo"
                    android:padding="4dp" />

                <!-- Fecha -->
                <LinearLayout
                    android:id="@+id/llFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical" android:paddingBottom="76dp">

                    <TextView
                        android:id="@+id/tvFechaProgramada"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fecha_hoy"
                        android:padding="10dp"
                        android:textColor="@color/texto_principal"
                        android:background="@drawable/bg_input_campo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnElegirFecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/negro"
                        app:strokeWidth="1dp"
                        android:text="@string/elegir"
                        android:textColor="@color/texto_principal"
                        android:textAllCaps="false" />

                </LinearLayout>

                <!-- Opciones extra -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpcionesExtra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/divisor"
                    app:strokeWidth="1dp"
                    android:text="⚙️ Opciones extra (emergencia, recurrencia…)"
                    android:textSize="12sp"
                    android:textColor="@color/texto_secundario"
                    android:textAllCaps="false" />

                <!-- Botón crear -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCrearTarea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    style="@style/Widget.MaterialComponents.Button"
                    app:cornerRadius="10dp"
                    android:backgroundTint="@color/negro"
                    android:text="@string/crear"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>

