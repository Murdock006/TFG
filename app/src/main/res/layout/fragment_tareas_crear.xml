<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="72dp">

        <TextView
            android:id="@+id/tvTituloCrear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crear_tarea"
            android:textAppearance="@style/TextAppearance.TFG.Headline"
            android:textColor="@color/texto_principal"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/divisor"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp" android:paddingBottom="76dp">

                <!-- Título de la tarea -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.TFG.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/titulo_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="text"
                        android:autofillHints="none"
                        android:textColor="@color/texto_principal"
                        android:textColorHint="@color/gris" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Categoría -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria"
                    android:textAppearance="@style/TextAppearance.TFG.SubTitulo"
                    android:textColor="@color/texto_principal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <Spinner
                    android:id="@+id/spCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_campo"
                    android:padding="4dp" />

                <!-- Dificultad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dificultad"
                    android:textAppearance="@style/TextAppearance.TFG.SubTitulo"
                    android:textColor="@color/texto_principal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <Spinner
                    android:id="@+id/spDificultad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_campo"
                    android:padding="4dp" />

                <!-- Puntos -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPuntos"
                    style="@style/Widget.TFG.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/puntos_hint"
                    android:layout_marginTop="@dimen/spacing_md">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPuntos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:imeOptions="flagNoExtractUi"
                        android:autofillHints="none"
                        android:textColor="@color/texto_principal"
                        android:textColorHint="@color/gris" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvPuntosFijos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/puntos_fijos_200"
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Asignar a -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/asignar_a"
                    android:textAppearance="@style/TextAppearance.TFG.SubTitulo"
                    android:textColor="@color/texto_principal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <Spinner
                    android:id="@+id/spAsignarA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_campo"
                    android:padding="4dp" />

                <!-- Fecha -->
                <LinearLayout
                    android:id="@+id/llFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center_vertical" android:paddingBottom="76dp">

                    <TextView
                        android:id="@+id/tvFechaProgramada"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fecha_hoy"
                        android:padding="@dimen/spacing_sm"
                        android:textColor="@color/texto_principal"
                        android:background="@drawable/bg_input_campo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnElegirFecha"
                        style="@style/Widget.TFG.Boton.Contorno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/elegir"
                        android:textAllCaps="false" />

                </LinearLayout>

                <!-- Opciones extra -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpcionesExtra"
                    style="@style/Widget.TFG.Boton.Contorno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/opciones_extra"
                    android:textColor="@color/texto_secundario"
                    android:textAllCaps="false" />

                <!-- Botón crear -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCrearTarea"
                    style="@style/Widget.TFG.Boton.Relleno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:text="@string/crear"
                    android:textAllCaps="false" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>

