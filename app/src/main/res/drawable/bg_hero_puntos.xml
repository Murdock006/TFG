<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo "hero" para la tarjeta de puntos: degradado esmeralda diagonal.
     Se usan primario + brand_600 (rellenos de marca constantes en ambos temas)
     en lugar de primario_variant, que en values-night se aclara a #34C79A y
     dejaría el texto blanco con contraste insuficiente sobre el degradado. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/primario"
        android:endColor="@color/brand_600"
        android:type="linear" />
    <corners android:radius="24dp" />
</shape>
