<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Acciones del drawer. checkableBehavior="none" evita que queden marcadas como
        estados; solo el selector de tema es checkable.
    -->
    <group
        android:id="@+id/grupoAccionesDrawer"
        android:checkableBehavior="none">
        <item
            android:id="@+id/menuCuentaSeguridad"
            android:icon="@drawable/perfil"
            android:title="@string/cuenta_y_seguridad" />

        <item
            android:id="@+id/menuCambiarContrasena"
            android:icon="@android:drawable/ic_menu_edit"
            android:title="@string/cambiar_contrasena" />

        <item
            android:id="@+id/menuAyuda"
            android:icon="@android:drawable/ic_menu_help"
            android:title="@string/ayuda" />

        <item
            android:id="@+id/menuContactarSoporte"
            android:icon="@android:drawable/ic_dialog_email"
            android:title="@string/contactar_soporte" />

        <item
            android:id="@+id/menuComprarPuntos"
            android:icon="@android:drawable/ic_menu_add"
            android:title="@string/comprar_puntos" />

        <item
            android:id="@+id/menuSuscripcion"
            android:icon="@android:drawable/ic_menu_myplaces"
            android:title="@string/suscripcion" />

        <item
            android:id="@+id/menuPoliticaPrivacidad"
            android:icon="@android:drawable/ic_menu_info_details"
            android:title="@string/politica_privacidad" />
    </group>

    <!--
        Selector de tema. El <menu> anidado se renderiza como subtítulo ("Tema") y las
        tres opciones comparten un grupo de selección exclusiva (radio).
    -->
    <item
        android:id="@+id/menuTema"
        android:title="@string/tema">
        <menu>
            <group
                android:id="@+id/grupoTemaDrawer"
                android:checkableBehavior="single">
                <item
                    android:id="@+id/menuTemaClaro"
                    android:checkable="true"
                    android:title="@string/tema_claro" />

                <item
                    android:id="@+id/menuTemaOscuro"
                    android:checkable="true"
                    android:title="@string/tema_oscuro" />

                <item
                    android:id="@+id/menuTemaSistema"
                    android:checkable="true"
                    android:title="@string/tema_sistema" />
            </group>
        </menu>
    </item>

</menu>
